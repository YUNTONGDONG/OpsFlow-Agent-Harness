# Runtime mode. The reproducible baseline starts in demo mode without credentials.
APP_MODE=demo
AGENT_RUNTIME=harness

# Model used by the Harness router and answer generation in live mode.
BASE_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_API_BASE=

# Embeddings and local vector store.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_COLLECTION=langchain_docs
PERSIST_DIR=./vector_db
FAISS_INDEX_PATH=./rag_data/knowledge.faiss
RAG_DOCUMENTS_PATH=./rag_data/documents.jsonl
SVMRANK_MODEL_PATH=./rag_data/svmrank_weights.json
CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CROSS_ENCODER_REVISION=1427fd652930e4ba29e8149678df786c240d8825
CROSS_ENCODER_DEVICE=cpu
RAG_FAISS_TOP_K=5
RAG_SVM_TOP_K=20
RAG_FINAL_TOP_K=3
RAG_RELEVANCE_THRESHOLD=0
RAG_RETRIEVAL_MODE=faiss_cross_encoder
LIVE_RAG_QUERY=

# Redis state stores.
REDIS_URL=redis://localhost:6379/0

# Slack Socket Mode. Required only when running src.SlackWebHook.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Google Calendar and Tasks use credentials.json and token.pickle locally.
# Never commit either file.

# Optional log-platform integration.
LOG_API_URL=
LOG_API_TOKEN=
LOG_API_TIMEOUT_SECONDS=8
LIVE_LOG_SERVICE=
LIVE_LOG_ENVIRONMENT=
LIVE_LOG_START_TIME=
LIVE_LOG_END_TIME=
LIVE_LOG_KEYWORD=

# Explicit sandbox targets required by external write probes.
LIVE_GOOGLE_CALENDAR_ID=
LIVE_GOOGLE_TASKLIST_ID=
LIVE_SLACK_CHANNEL_ID=

# Local request trace output.
HARNESS_TRACE_PATH=logs/harness_trace.jsonl
HARNESS_MAX_CONCURRENCY=4
IDEMPOTENCY_TTL_SECONDS=604800
WORKSPACE_ROOT=workspaces
WORKSPACE_INLINE_MAX_BYTES=32768
USER_PROFILE_TTL_SECONDS=2592000
